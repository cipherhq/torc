# Copy this to .env and fill in your values

# Supabase project URL (from Supabase Dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (from Supabase Dashboard → Settings → API)
# ⚠️ Keep this secret! Only use in server-side code, never in client apps
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Test user IDs (get these from your auth.users or profiles table)
# Use UUIDs of real users in your database for testing
TEST_CUSTOMER_ID=00000000-0000-0000-0000-000000000001
TEST_PROVIDER_1_ID=00000000-0000-0000-0000-000000000002
TEST_PROVIDER_2_ID=00000000-0000-0000-0000-000000000003

# Test service ID (from your services table)
TEST_SERVICE_ID=00000000-0000-0000-0000-000000000004
