{
  "name": "torc-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@capacitor/ios": "^8.1.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/supabase-js": "^2.97.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "embla-carousel-react": "^8.6.0",
    "expo-server-sdk": "^4.0.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.487.0",
    "motion": "^12.34.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "react-router": "^7.13.0",
    "recharts": "^2.15.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.2.2",
    "vaul": "^1.1.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "husky": "^9.1.7",
    "vite": "6.3.5"
  },
  "scripts": {
    "dev:customer": "npm run dev --workspace=customer-web",
    "dev:provider": "npm run dev --workspace=provider-web",
    "dev:admin": "npm run dev --workspace=admin-web",
    "dev:website": "npm run dev --workspace=website",
    "worker:push": "node workers/push-notification-worker.js",
    "worker:push:staging": "cd workers && DOTENV_CONFIG_PATH=.env.staging node -r dotenv/config push-notification-worker.js",
    "build:all": "npm run build --workspace=admin-web && npm run build --workspace=customer-web && npm run build --workspace=provider-web && npm run build --workspace=website",
    "build:customer": "npm run build --workspace=customer-web",
    "build:provider": "npm run build --workspace=provider-web",
    "build:admin": "npm run build --workspace=admin-web",
    "build:website": "npm run build --workspace=website",
    "build:staging:all": "npm run build:staging --workspace=admin-web && npm run build:staging --workspace=customer-web && npm run build:staging --workspace=provider-web",
    "build:staging:customer": "npm run build:staging --workspace=customer-web",
    "build:staging:provider": "npm run build:staging --workspace=provider-web",
    "build:staging:admin": "npm run build:staging --workspace=admin-web",
    "test:admin": "npm run test --workspace=admin-web",
    "test:customer": "npm run test --workspace=customer-web",
    "test:provider": "npm run test --workspace=provider-web",
    "test:all": "npm run test --workspace=admin-web && npm run test --workspace=customer-web && npm run test --workspace=provider-web",
    "test:unit": "npm run test:all",
    "lint": "echo 'No linter configured yet'",
    "typecheck": "echo 'No tsconfig files yet — skipping type check'",
    "validate:migrations": "for f in database/migrations/*.sql supabase/migrations/*.sql; do test -s \"$f\" || (echo \"Empty migration: $f\" && exit 1); done && echo 'All migrations valid'",
    "ci": "npm run test:all && npm run build:all",
    "prepare": "husky"
  }
}
