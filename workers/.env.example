# Copy this to .env and fill in your values

# Postgres connection string (get from Supabase: Settings → Database → Connection string)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (Settings → API → service_role key)
# ⚠️ Keep this secret! Never commit to Git or expose in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment
NODE_ENV=production
