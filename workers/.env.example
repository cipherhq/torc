# Copy this to .env and fill in your values

# Postgres connection string (get from Supabase: Settings → Database → Connection string)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (Settings → API → service_role key)
# ⚠️ Keep this secret! Never commit to Git or expose in client code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Environment
NODE_ENV=production

# Firebase (FCM) credentials for Android native push (and iOS if using FCM)
# Preferred: point to a service account file stored outside Git
FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-admin.json
# Alternative: inline JSON string
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# Alternative: split fields
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# APNs direct credentials for iOS native push tokens
APNS_CUSTOMER_BUNDLE_ID=com.torc.customer
APNS_PROVIDER_BUNDLE_ID=com.torc.provider
APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_KEY_ID=YOUR_APNS_KEY_ID
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# true for local/sandbox builds, false for TestFlight/App Store
APNS_USE_SANDBOX=false

# Twilio SMS (optional — for notifying "someone else" requesters via SMS)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxx

# Encryption key for BYO payment credentials (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key-here
