# Supabase Configuration
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# Twilio (SMS/OTP)
TWILIO_ACCOUNT_SID=ACxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Environment
VITE_APP_ENV=development
VITE_APP_NAME=Torc
VITE_APP_URL=http://localhost:5173
# Production: set to https://www.torcapp.com so password reset emails link there

# Optional: Custom Backend API (if building one)
VITE_API_URL=http://localhost:3000

# Optional: Analytics
VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Optional: Sentry (Error Tracking)
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Push Worker (server-side)
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Firebase (FCM) for native Android/iOS push tokens
# Option A: single JSON string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# Option B: path to downloaded service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json
# Option C: split values
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n\"

# APNs direct fallback (for iOS APNs tokens from Capacitor)
APNS_TEAM_ID=ABCDE12345
APNS_KEY_ID=ABC123DEF4
APNS_PRIVATE_KEY=\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n\"
APNS_CUSTOMER_BUNDLE_ID=com.torc.customer
APNS_PROVIDER_BUNDLE_ID=com.torc.provider
APNS_USE_SANDBOX=true

# Encryption key for BYO payment credentials (business_payment_credentials table)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=your-64-char-hex-key-here
