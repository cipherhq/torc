# TORC Customer — Production Release Configuration
#
# This file is used when building for production store release (TestFlight / Play Store).
# ALL values must be injected by the release build environment.
# DO NOT commit real credentials here.
#
# The app's configValidation.ts will FAIL CLOSED if any value contains:
#   - localhost / 127.0.0.1
#   - *.vercel.app preview hosts
#   - pk_test_ / sk_test_ / sk_live_ keys
#   - service-role references
#
# To build for Vercel internal deployment, use: vite build --mode internal

VITE_APP_ENV=production
VITE_APP_NAME=TORC

# --- REQUIRED: Set by release build environment ---
# VITE_APP_URL=https://app.torcapp.com
# VITE_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_PRODUCTION_ANON_KEY
# VITE_GOOGLE_MAPS_API_KEY=YOUR_PRODUCTION_MAPS_KEY
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_PRODUCTION_KEY
